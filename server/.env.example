# Copy to server/.env and adjust. The API starts with these defaults,
# so an empty .env is a valid demo configuration.

# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# MongoDB. Leave blank to keep enquiries in memory for the session (demo mode:
# nothing survives a restart, and the API reports database: "memory").
MONGODB_URI=

# Institution this deployment represents. Stored on every enquiry so the same
# database can serve more than one campus.
INSTITUTION_ID=aurevia-school

# true  = the site shows demo notices and the API reports demo mode
# false = hide demo notices (use only when the content is real)
DEMO_MODE=true

# CRM hand-off
# disabled = enquiries are stored locally and forwarding is reported as skipped
# live     = POST every enquiry to CRM_API_URL (see services/crm/http-crm-adapter.ts)
CRM_MODE=disabled
CRM_API_URL=
CRM_API_KEY=
CRM_TIMEOUT_MS=6000

# Rate limiting for the public form endpoints
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX=30

# debug | info | warn | error
LOG_LEVEL=info
